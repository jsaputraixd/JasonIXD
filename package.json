{
  "name": "jason-saputra-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3000",
    "serve:prod": "next start -H 127.0.0.1 -p 3000",
    "dev:clean": "rm -rf .next && next dev -H 127.0.0.1 -p 3000",
    "dev:turbo": "next dev --turbo -H 127.0.0.1 -p 3000",
    "merge-pdfs": "node scripts/merge-case-study-decks.mjs",
    "generate:listen-audio": "node --env-file=./.env.local scripts/generate-listen-audio.mjs",
    "generate:listen-audio:wait": "node --env-file=./.env.local scripts/generate-listen-audio.mjs --wait",
    "generate:listen-audio:force": "node --env-file=./.env.local scripts/generate-listen-audio.mjs --force",
    "build": "next build --webpack",
    "preview": "next build --webpack && next start -H 127.0.0.1 -p 3000",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "framer-motion": "^11.11.0",
    "next": "^16.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14"
  }
}
