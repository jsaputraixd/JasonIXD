# Production URL (set the same key in Vercel: Settings → Environment Variables → Production)
NEXT_PUBLIC_SITE_URL=https://jasonixd.com

# ElevenLabs text-to-speech (server-only — never prefix with NEXT_PUBLIC_)
# Used by: npm run generate:listen-audio
# Create a key at https://elevenlabs.io/app/settings/api-keys
# Pick a voice ID from https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional — defaults to eleven_turbo_v2_5 (fast + natural)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
